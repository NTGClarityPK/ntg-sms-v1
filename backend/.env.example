SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Required for Settings → Data export (password re-verification). Use the same value as NEXT_PUBLIC_SUPABASE_ANON_KEY in the frontend.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Temporary migration only — default false. When true, legacy @ntg.com-style emails regain elevated access (logged).
# Assign super_admin in user_roles for ops accounts, then keep this false. See docs/security/privileged-access-migration.md
ALLOW_EMAIL_DOMAIN_PRIVILEGE_ESCALATION=false

# Google Classroom (read-only grade sync) — optional; feature stays disconnected until configured
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=http://localhost:3001/api/v1/google-workspace/oauth-callback
# 32+ character secret used to encrypt Workspace OAuth tokens at rest
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Stripe (subscription invoice checkout — optional; Pay Now hidden when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Public HTTPS URL to the NTG Alma logo image for invitation emails.
# If unset, defaults to {FRONTEND_URL}/alma-logo-darkgreen.svg (must be reachable by email clients).
# INVITATION_NTG_LOGO_URL=https://your-app.example.com/alma-logo-darkgreen.svg

MAILJET_API_KEY= 97f39b566235905cbfeaafd8dee889c7
MAILJET_SECRET_KEY=1190feca38b9b6ee6bb4bb7a4287ad9a
MAILJET_FROM_EMAIL= alma.ntgapps.com
MAILJET_FROM_NAME=  NTG Alma

# Invitations / email
# Limit is per created invitation record (bulk import may create 2 per student when parent accounts are enabled)
INVITATIONS_RATE_LIMIT_PER_MINUTE=20

# Optional background cron jobs (true / false).
# If unset: tenant deletion stays off; others run in production only.
INVITATIONS_EXPIRE_UNUSED_JOB_ENABLED=false
SUBSTITUTION_REMINDERS_JOB_ENABLED=false
TENANT_DELETION_JOB_ENABLED=false
LATE_FEE_JOB_ENABLED=false
SUBSCRIPTION_END_OF_PERIOD_JOB_ENABLED=false