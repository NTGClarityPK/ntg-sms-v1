{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "modules/id-cards/templates/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      },
      {
        "include": "modules/certificates/templates/**/*",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  },
  "watchOptions": {
    "usePolling": false,
    "interval": 1000,
    "binaryInterval": 3000
  }
}

